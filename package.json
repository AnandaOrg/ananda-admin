{
  "name": "ananda-admin",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm --filter @ananda/shared build && pnpm -r --parallel --filter @ananda/api --filter @ananda/web --filter @ananda/shared dev",
    "build": "pnpm --filter @ananda/shared build && pnpm --filter @ananda/api build && pnpm --filter @ananda/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d db mail",
    "db:generate": "pnpm --filter @ananda/api db:generate",
    "db:migrate": "pnpm --filter @ananda/api db:migrate",
    "db:seed": "pnpm --filter @ananda/api db:seed",
    "db:reset": "pnpm --filter @ananda/api db:reset",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down"
  }
}

DATABASE_URL=postgres://ananda:ananda@localhost:5433/ananda
PORT=4010
WEB_ORIGIN=http://localhost:3010
SMTP_HOST=localhost
SMTP_PORT=1026
MAIL_FROM="ANANDA <office@ananda.bg>"
UPLOAD_DIR=./uploads
# Development only: this code is accepted as a valid two-step code when NODE_ENV is not production.
DEV_TWO_STEP_CODE=000000
# Optional: enables "Polish with AI" on drafted e-mails.
ANTHROPIC_API_KEY=
# SMTP over TLS (e.g. port 465). Set SMTP_USER / SMTP_PASS for a hosted provider.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Vercel Cron sends this as a bearer token to /api/cron/*.
CRON_SECRET=
# Vercel Blob (set automatically when a Blob store is connected to the project). Empty = local disk.
BLOB_READ_WRITE_TOKEN=

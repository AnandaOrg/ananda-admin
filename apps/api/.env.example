# ANANDA API environment.
# Copy to .env for local development (`cp .env.example .env`). .env is git-ignored; never commit secrets.

# ---------- Local development (pnpm dev) ----------
DATABASE_URL=postgres://ananda:ananda@localhost:5433/ananda
PORT=4010
WEB_ORIGIN=http://localhost:3010
UPLOAD_DIR=./uploads
# Mailpit from docker-compose (inbox at http://localhost:8026).
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ANANDA <office@ananda.bg>"
# Development only: accepted as a two-step code when NODE_ENV is not production.
DEV_TWO_STEP_CODE=000000

# ---------- Vercel (Project → Settings → Environment Variables) ----------
# Set automatically, do not add by hand: DATABASE_URL (Neon integration), BLOB_* (Blob store),
# and the web address for links (from the deployment URL).
# Do not set on Vercel: DEV_TWO_STEP_CODE, ALLOW_DEV_TWO_STEP_CODE, COOKIE_SECURE, PORT, UPLOAD_DIR, WEB_ORIGIN.

# Bearer token Vercel Cron sends to /api/cron/*. Generate with: openssl rand -hex 32
CRON_SECRET=
# Build with the pnpm version pinned in package.json.
ENABLE_EXPERIMENTAL_COREPACK=1
# Optional: enables "Polish with AI" on drafted e-mails.
ANTHROPIC_API_KEY=
# Private Vercel Blob store (added when a store is connected). Empty = local disk.
BLOB_READ_WRITE_TOKEN=

# Your mail server on Vercel (port 465 with SMTP_SECURE=true, or 587 with SMTP_SECURE=false).
# Kept commented here so local development keeps using Mailpit above.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="ANANDA <office@ananda.bg>"

# Preview environment only: load demo data into preview databases (the seed never sends e-mail).
# SEED_DEMO=true
